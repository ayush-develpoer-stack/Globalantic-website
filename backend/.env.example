# Copy to .env and fill in real values. NEVER commit real values to this file.

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database (Supabase PostgreSQL) ----
# Transaction-mode pooler (runtime queries)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Session-mode / direct connection (used by prisma migrate)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: share the session cookie across subdomains in production, e.g. .globalantic.com
COOKIE_DOMAIN=
# Session cookie SameSite: lax (default; API on the same site as the portals) | strict | none (API on another site; forces Secure)
COOKIE_SAMESITE=lax

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Globalantic <no-reply@example.com>
ADMIN_EMAIL=info@globalantic.com
# Public main website (links in admin notifications to its embedded admin)
MAIN_SITE_URL=http://localhost:3000
# Who receives business/admin notification emails (comma-separated). Editable later in
# Admin -> Notifications -> Settings, which takes precedence when it lists any address.
BUSINESS_NOTIFICATION_EMAILS=info@globalantic.com,info.globalantic@gmail.com

# ---- Allowed browser origins (CORS). Comma-separate multiple origins. ----
# Production example: https://globalantic.com,https://training.globalantic.com,https://intern.globalantic.com,https://admin.globalantic.com,https://trainer.globalantic.com
FRONTEND_URL=http://localhost:3000
# Public URLs used in emails / referral links
TRAINING_URL=http://localhost:3001
INTERN_PORTAL_URL=http://localhost:3002
EMPLOYEE_PORTAL_URL=http://localhost:3003

# ---- Private file uploads ----
# Absolute path OUTSIDE any web root, on a persistent (backed-up) disk. Required in production.
# Dev default when empty: ~/.globalantic/uploads
UPLOAD_DIR=
UPLOAD_MAX_BYTES=5242880
# Public base URL of this API, used for public course/CMS image links (e.g. https://api.globalantic.com/api)
PUBLIC_API_URL=http://localhost:4000/api

# ---- Razorpay (payments). Leave empty to keep payments disabled. ----
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=

# ---- Privacy: secret used to hash IPs for referral click/fraud tracking ----
HASH_SALT=replace-with-a-long-random-string

# ---- Cloudinary (optional, only if image upload is used) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seed admin (used by prisma/seed.ts) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-unique-password
SEED_ADMIN_NAME=Globalantic Admin

# --- Sales CRM ---
# Admin portal base URL (links in lead alerts and reminders)
ADMIN_PORTAL_URL=http://localhost:3004
# Trainer portal (optional; shown to admins after creating a trainer account)
TRAINER_PORTAL_URL=http://localhost:3005
# Business WhatsApp in international digits (wa.me link in acknowledgement emails)
BUSINESS_WHATSAPP=917697845157
# Shared secret for the scheduler calling POST /api/crm/reminders/dispatch (header x-cron-secret). Empty = endpoint disabled.
CRON_SECRET=
