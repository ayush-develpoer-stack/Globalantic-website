# =============================================================================
# Globalantic API — PRODUCTION environment template (api.globalantic.com)
# Set these as secrets on the backend host (Render/Railway/…). Do NOT commit a
# filled-in copy. Values in <angle brackets> are secrets or not yet decided.
# Local development keeps using backend/.env (see .env.example).
# The API refuses to start in production if any *_URL below or FRONTEND_URL is missing.
# =============================================================================

NODE_ENV=production
# Most hosts inject PORT themselves; keep it unset there.
PORT=4000

# ---- Database (Supabase) ----
DATABASE_URL=<supabase transaction-pooler URL>
DIRECT_URL=<supabase session-pooler URL, used only by `prisma migrate deploy`>

# ---- Auth / sessions ----
JWT_SECRET=<random, 64+ chars, NEW value (rotate)>
JWT_EXPIRES_IN=7d
HASH_SALT=generate-a-long-random-string
# One sign-in shared by every portal subdomain. All portals are on the same site
# (globalantic.com), so SameSite=lax works and still blocks cross-site CSRF.
COOKIE_DOMAIN=.globalantic.com
COOKIE_SAMESITE=lax

# ---- CORS allow-list: every production frontend origin (exact, https, no trailing slash) ----
FRONTEND_URL=https://globalantic.com,https://training.globalantic.com,https://intern.globalantic.com,https://employee.globalantic.com,https://admin.globalantic.com,https://trainer.globalantic.com

# ---- Public URLs used in emails, redirects, certificates and stored image paths ----
MAIN_SITE_URL=https://globalantic.com
TRAINING_URL=https://training.globalantic.com
INTERN_PORTAL_URL=https://intern.globalantic.com
EMPLOYEE_PORTAL_URL=https://employee.globalantic.com
ADMIN_PORTAL_URL=https://admin.globalantic.com
# Optional: shown to admins after creating a trainer account
TRAINER_PORTAL_URL=https://trainer.globalantic.com
PUBLIC_API_URL=https://api.globalantic.com/api

# ---- Email (Resend) ----
RESEND_API_KEY=<resend key, NEW value (rotate)>
# Must be an address on a domain verified in Resend.
RESEND_FROM_EMAIL=<Globalantic <no-reply@your-verified-domain>>
ADMIN_EMAIL=info@globalantic.com
BUSINESS_NOTIFICATION_EMAILS=info@globalantic.com,info.globalantic@gmail.com
BUSINESS_WHATSAPP=917697845157

# ---- Payments (Razorpay) ----
# Webhook URL to register in the Razorpay dashboard:
#   https://api.globalantic.com/api/payments/razorpay/webhook
RAZORPAY_KEY_ID=<rzp_live_… (rzp_test_… for staging)>
RAZORPAY_KEY_SECRET=<razorpay key secret>
RAZORPAY_WEBHOOK_SECRET=<secret entered when creating the webhook>

# ---- Scheduled jobs ----
# Scheduler calls POST /api/crm/reminders/dispatch and POST /api/notifications/dispatch with this secret.
CRON_SECRET=<random, 32+ chars>
# Optional: shared with the Next.js servers for SSR calls (>= 32 chars); empty = disabled.
INTERNAL_API_TOKEN=

# ---- Files ----
# Persistent disk path on the host (outside any web root).
UPLOAD_DIR=<e.g. /var/data/uploads>
UPLOAD_MAX_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
