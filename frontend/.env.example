# Public base URL of the backend REST API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL used for canonical URLs, sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source: "mock" (built-in fixtures, no backend needed) or "api" (real backend).
# Unset = "api". Set "mock" ONLY for local demo/UI work; never in production.
NEXT_PUBLIC_DATA_SOURCE=api

# Mock mode only: normal | empty | error | slow (simulates states for QA).
NEXT_PUBLIC_MOCK_SCENARIO=normal

# Optional contact channels shown in the UI (digits with country code for WhatsApp).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
# Optional consultation booking page (e.g. Calendly). Booking buttons stay hidden while empty.
NEXT_PUBLIC_BOOKING_URL=
