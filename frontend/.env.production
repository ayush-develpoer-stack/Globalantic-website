# Production build values (loaded by `next build` / `next start` only; `next dev` uses .env.development).
# Public values only — they are inlined into the browser bundle. Never put secrets here.
# Variables set in the hosting dashboard (e.g. Vercel) take precedence over this file.
# Search indexing is controlled separately: VERCEL_ENV=production or ALLOW_INDEXING=true (set on the host).

# Public base URL of the backend REST API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.globalantic.com/api
# Public site URL used for canonical URLs, sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL=https://globalantic.com
# Training platform (links from the main site)
NEXT_PUBLIC_TRAINING_URL=https://training.globalantic.com
NEXT_PUBLIC_DATA_SOURCE=api
