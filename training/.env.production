# Production build values (loaded by `next build` / `next start` only; `next dev` uses .env.development).
# Public values only — inlined into the browser bundle. Never put secrets here.
# Variables set in the hosting dashboard take precedence over this file.
# Search indexing: VERCEL_ENV=production or ALLOW_INDEXING=true (set on the host).
NEXT_PUBLIC_API_URL=https://api.globalantic.com/api
NEXT_PUBLIC_TRAINING_URL=https://training.globalantic.com
NEXT_PUBLIC_INTERN_PORTAL_URL=https://intern.globalantic.com
NEXT_PUBLIC_ADMIN_URL=https://admin.globalantic.com
NEXT_PUBLIC_TRAINER_URL=https://trainer.globalantic.com
NEXT_PUBLIC_MAIN_SITE_URL=https://globalantic.com
